# Use a lightweight NGINX web server
FROM nginx:alpine

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy the static frontend files (HTML/CSS/JS) into the NGINX serving directory
COPY ["PHASE 4/frontend/", "/usr/share/nginx/html/"]

# Expose port 80 for the web traffic
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
